; Aequitas TLD Zone File
; All 94+ sovereign subdomains

$ORIGIN aequitas.
$TTL 300

; SOA Record
@ IN SOA ns1.aequitasprotocol.zone. hostmaster.aequitas. (
    2025121101  ; Serial
    3600        ; Refresh
    1800        ; Retry
    604800      ; Expire
    300         ; Minimum TTL
)

; Name Servers
@           IN NS ns1.aequitasprotocol.zone.
@           IN NS ns2.aequitasprotocol.zone.

; Core Infrastructure
rpc         IN A 135.232.208.145
api         IN A 135.232.208.145
explorer    IN A 135.232.208.145
grpc        IN A 135.232.208.145
