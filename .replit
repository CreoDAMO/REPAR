modules = ["go-1.21", "nodejs-20", "python-3.11", "bash"]
[agent]
expertMode = true
integrations = ["python_openai:1.0.0", "python_anthropic:1.0.0", "python_database:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["buf", "cargo", "ignite-cli", "libiconv", "libxcrypt", "libyaml", "openssh_gssapi", "openssl", "pkg-config", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Block Explorer"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm install && npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Block Explorer"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd dexplorer && npm install && npm run dev"
waitForPort = 3001

[[workflows.workflow]]
name = "Build & Deploy"
author = 48926778
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd aequitas && go mod tidy && go build -o ../repar-node ./cmd/aequitasd"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ../backend && npm install --prefer-offline --no-audit"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ../frontend && npm install --prefer-offline --no-audit && npm run dev -- --host 0.0.0.0 --port 5000"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm install && npm start"
waitForPort = 3002

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd frontend && npm run preview -- --host 0.0.0.0 --port 5000 & cd backend && npm start"]
build = ["bash", "-c", "cd frontend && npm install && npm run build && cd ../backend && npm install"]
