{
  "cli": {
    "version": ">= 13.2.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "appBundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "support@aequitasprotocol.zone",
        "ascAppId": "pending",
        "appleTeamId": "pending"
      },
      "android": {
        "serviceAccountKeyPath": "pending",
        "track": "internal"
      }
    }
  }
}
