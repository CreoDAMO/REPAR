# ============================================================
# AEQUITAS PROTOCOL - ENVIRONMENT CONFIGURATION
# December 1, 2025 - Constellation Architecture
# ============================================================

# ============================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================
VITE_COSMOS_RPC_URL=http://localhost:26657
VITE_CHAIN_ID=aequitas-1
VITE_DENOM=repar

# ============================================================
# PRIMARY AI SYSTEM - APEX (LOCAL, REQUIRED)
# ============================================================
# APEX is the primary sovereign AI system
# Uses local LLM ensemble - NO API KEYS NEEDED
# Models: Llama 3.1 8B, Mistral 7B, Phi-3 Mini, DeepSeek Coder
# 100% offline, cannot be shut down, no external dependencies
APEX_AI_SYSTEM=enabled
APEX_LLM_MODELS=llama-3.1,mistral,phi-3,deepseek

# ============================================================
# CRITICAL SERVICES (Constellation-Based)
# ============================================================

# Circle SDK - REQUIRED for USDC payments
# Get key at: https://www.circle.com/en/developers
# Used for: Justice Burn, reparations distribution, validator subsidies
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_32_byte_hex_secret_here

# Cloudflare - REQUIRED for DNS & domain management
# Get token at: https://dash.cloudflare.com/
# Used for: aequitasprotocol.zone domain and 24+ subdomains
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# ============================================================
# OPTIONAL: External AI Enhancements (System works without these)
# ============================================================

# OpenAI - https://platform.openai.com/api-keys
# Optional enhancement only - not required
OPENAI_API_KEY=

# Anthropic Claude - https://console.anthropic.com/
# Optional enhancement only - not required
ANTHROPIC_API_KEY=

# X.AI Grok - https://console.x.ai/
# Optional enhancement only - not required
XAI_API_KEY=

# ============================================================
# OPTIONAL: Payment & Commerce
# ============================================================

# Coinbase Commerce for fiat onramp
# Get key at: https://commerce.coinbase.com/
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ============================================================
# OPTIONAL: Decentralized Infrastructure
# ============================================================

# IPFS Gateway for evidence storage
IPFS_GATEWAY=https://ipfs.io

# ============================================================
# OPTIONAL: Monitoring & Analytics
# ============================================================

# Sentry for error tracking
SENTRY_DSN=

# SendGrid for email notifications
SENDGRID_API_KEY=

# ============================================================
# SECURITY CONFIGURATION
# ============================================================

# Session secret - Generate: openssl rand -hex 32
SESSION_SECRET=your_session_secret_here

# ============================================================
# DEVELOPMENT SETTINGS
# ============================================================

NODE_ENV=development
PORT=5000
BACKEND_PORT=3002
DEXPLORER_PORT=3001

# ============================================================
# PRODUCTION OVERRIDES
# ============================================================
# For production deployment, uncomment and configure:
# NODE_ENV=production
# VITE_COSMOS_RPC_URL=https://rpc.aequitasprotocol.zone
# VITE_CHAIN_ID=aequitas-1
# PORT=443
# BACKEND_PORT=443

# ============================================================
# CONSTELLATION ARCHITECTURE NOTES
# ============================================================
# 
# CRITICAL (Required for operation):
# - APEX_AI_SYSTEM: Local LLM ensemble (Llama, Mistral, Phi-3, DeepSeek)
# - CIRCLE_API_KEY: USDC payments
# - CLOUDFLARE_API_TOKEN: Domain/DNS management
#
# OPTIONAL (Enhancements only - system operates without them):
# - OPENAI_API_KEY: Optional AI enhancement
# - ANTHROPIC_API_KEY: Optional AI enhancement
# - XAI_API_KEY: Optional AI enhancement
# - COINBASE_API_KEY: Optional fiat onramp
# - SENTRY_DSN: Optional error tracking
# - SENDGRID_API_KEY: Optional email notifications
#
# NO LONGER USED:
# - NVIDIA_API_KEY: Replaced by local APEX LLM ensemble
# - DIGITALOCEAN_ACCESS_TOKEN: Replaced by constellation architecture
# - DEEPSEEK_API_KEY: Now part of APEX local ensemble
#
# The system is PLATFORM-AGNOSTIC:
# - Deployable on ACE/AVM constellation nodes (satellite protocol)
# - Zero dependency on Replit, DigitalOcean, or cloud providers
# - Fully functional with only APEX + Circle + Cloudflare
