FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY ../../ace/ai-sidecar/requirements.txt /app/sidecar-requirements.txt
RUN pip install --no-cache-dir -r sidecar-requirements.txt

COPY ../../auditor/requirements.txt /app/auditor-requirements.txt
RUN pip install --no-cache-dir -r auditor-requirements.txt

COPY ../../auditor /app/auditor
COPY ../../ace/ai-sidecar /app/ace-sidecar

ENV PYTHONPATH=/app
ENV NVIDIA_API_KEY=""
ENV ACE_SIDECAR_PORT=8001
ENV ACE_SIDECAR_HOST=0.0.0.0

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8001/health')"

CMD ["python", "/app/ace-sidecar/ace_sidecar.py"]
